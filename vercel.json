{
  "redirects": [
    {
      "source": "/3D",
      "destination": "/obs/",
      "permanent": true
    },
    {
      "source": "/3D/",
      "destination": "/obs/",
      "permanent": true
    },
    {
      "source": "/3D/:path*",
      "destination": "/obs/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/obs",
      "destination": "/obs/dist/index.html"
    },
    {
      "source": "/obs/",
      "destination": "/obs/dist/index.html"
    },
    {
      "source": "/obs/index.html",
      "destination": "/obs/dist/index.html"
    },
    {
      "source": "/obs/obs.html",
      "destination": "/obs/dist/obs.html"
    },
    {
      "source": "/obs/obs",
      "destination": "/obs/dist/obs.html"
    },
    {
      "source": "/obs/ship-exterior-cinema.html",
      "destination": "/obs/dist/ship-exterior-cinema.html"
    },
    {
      "source": "/obs/ship-exterior-study.html",
      "destination": "/obs/dist/ship-exterior-study.html"
    },
    {
      "source": "/obs/sofa-study.html",
      "destination": "/obs/dist/sofa-study.html"
    },
    {
      "source": "/obs/gate-frame-study.html",
      "destination": "/obs/dist/gate-frame-study.html"
    },
    {
      "source": "/obs/assets/:path*",
      "destination": "/obs/dist/assets/:path*"
    }
  ],
  "headers": [
    {
      "source": "/obs/assets/([A-Za-z0-9_-]+-[A-Za-z0-9_-]{8})\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
